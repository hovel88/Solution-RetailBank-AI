@startuml initiative_1_C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container — Флагман: сервис приоритизации очереди финмониторинга

Person(analyst, "Аналитик финмониторинга", "Разбирает операции, принимает решение о блокировке/отказе")
Person_Ext(regulator, "Надзор / ПОД-ФТ", "Внешние требования и предписания (вне контура)")
System_Ext(abs, "Источник операций", "")
System_Ext(know_client, "Платформа «Знай своего клиента»", "Вспомогательный сигнал уровня риска клиента")

System_Boundary(bank, "Контур банка") {
    Container(queue_in, "Очередь входящих операций", "Kafka", "Приём операций из банковских систем и других каналов, буфер под пиковую нагрузку; retry-политика")
    Container(dispatcher, "Обработчик очереди (оркестратор)", "Приложение", "Забирает операцию из queue_in. Проверяет обязательность (крупная сумма, 115-ФЗ, высокий риск) по полям самой операции. Вызывает features/validator. При сбое кладёт в retry_queue с пометкой")
    ContainerDb(retry_queue, "Отложенная очередь (retry)", "Хранилище", "Операции, которые не могут быть обработаны сейчас (features/validator недоступны). Ждут восстановления. Идемпотентность по operation_id")
    Container(features, "Сервис признаков", "Приложение", "Табличные признаки + агрегаты по клиенту/контрагенту; читает кеш LLM-нормализации")
    System_Boundary(llm_edge, "Опциональный LLM-контур") {
        Container(llm_norm, "LLM-нормализация текста (опционально)", "LLM", "Признаки/эмбеддинги из свободного текста назначения платежа. Включается только при доказанном приросте на приёмочном наборе")
        ContainerDb(llm_cache, "Кеш LLM-нормализации", "Хранилище", "Результат нормализации текста по operation_id + версия LLM; чтобы retry не гонял LLM повторно")
    }
    Container(model, "Модель ранжирования", "ML (градиентный бустинг)", "Оценка риска операции; обучаемое звено")
    Container(calib, "Калибровка и порог", "Приложение", "Приведение оценки к рабочей шкале, выбор top-N по пропускной способности")
    Container(rules, "Детерминированные бизнес-правила", "Приложение", "Дробление под порог, дубли, лимиты, накопительные проверки; работают без модели (fallback)")
    Container(validator, "Валидатор контракта", "Приложение", "Единственное место, где решается судьба операции: схема, диапазоны, инварианты, отсутствие утечек; формирует validation_status и validation_notes")
    Container(expert_queue, "Очередь и интерфейс аналитика", "Kafka/RabbitMQ/Приложение", "Сообщения контракта (validation_status, validation_notes); действия: подтвердить / отклонить / на расследование")
    ContainerDb(quarantine, "Карантин", "Хранилище", "Операции с критичными нарушениями контракта; разбор дежурным")
    ContainerDb(log, "Журнал решений", "Хранилище", "Версия модели, вход, выход, сработавшие признаки, validation_status, решение человека, время")
    Container(monitor, "Мониторинг и алерты", "Приложение", "Сигналы по входу, модели, очереди, бизнес-метрике")
    ContainerDb(refdata, "Справочники и лимиты", "БД", "Тарифы, лимиты, ОКВЭД, перечни")
}

System_Boundary(standard_queue_boundary, "Штатная очередь\n(существующий процесс)") {
    Container(standard_rules, "Отбор правилами и жалобами", "Приложение", "Существующий отбор операций для финмониторинга. Работает независимо от ML-сервиса")
    Container(standard_queue, "Штатная очередь эксперта", "Приложение", "Текущая очередь операций, отобранных правилами и жалобами. Пополняется независимо от сбоев ML-сервиса")
}

Rel(abs, queue_in, "Операции\n(⚠️1)", "API / выгрузка")
Rel(queue_in, dispatcher, "Операция")
Rel(dispatcher, features, "Вызов признаков")
Rel(dispatcher, rules, "Обязательные сигналы (крупные суммы, 115-ФЗ, высокий риск)", "обход сервиса признаков по полям самой операции, проверка обязательности — детерминированная, не требует features")
Rel(dispatcher, retry_queue, "features/validator недоступен", "кладёт операцию с пометкой «признаки недоступны» / «валидатор недоступен»")
Rel(queue_in, llm_norm, "Текст назначения платежа (если включена)\n(⚠️2)")
Rel(llm_norm, llm_cache, "Результат нормализации (кеш)\n(⚠️3)")
Rel(llm_cache, features, "Признаки из текста (из кеша или после нормализации)")
Rel(refdata, features, "Справочники, лимиты")
Rel(know_client, features, "Уровень риска клиента (вспомогательный)\n(⚠️4)")
Rel(features, model, "Вектор признаков")
Rel(features, rules, "Вектор признаков\n(fallback, если модель недоступна)")
Rel(model, calib, "Оценка риска\n(⚠️5)")
Rel(calib, rules, "Top-N и оценки")
Rel(rules, validator, "Обычный путь: операция с отметками правил")
Rel(dispatcher, validator, "Вызов валидатора")
Rel(validator, expert_queue, "ok или ok_with_notes\n(⚠️6)", "контракт: сообщение с validation_status и validation_notes")
Rel(validator, quarantine, "quarantined", "критичные нарушения контракта")
Rel(expert_queue, analyst, "Очередь на разбор")
Rel(analyst, log, "Решение человека")
Rel(validator, log, "Результат проверки контракта")
Rel(model, log, "Версия модели и оценка")
Rel(monitor, log, "")
Rel(monitor, expert_queue, "")
Rel(monitor, model, "")
Rel(monitor, features, "")

Rel(queue_in, standard_rules, "Операции для штатного отбора\n(не зависит от ML-сервиса)")
Rel(standard_rules, standard_queue, "Штатный отбор")
Rel(standard_queue, analyst, "Штатная очередь на разбор\n(продолжает работать при сбое ML-сервиса)")

Rel(retry_queue, dispatcher, "Повторная обработка после восстановления", "сверка входного потока с очередью, дедупликация по operation_id, пометка «обработано после сбоя»")

' обход при отказе валидатора
Rel(rules, expert_queue, "Обход при отказе валидатора: упрощённая проверка", "пометка «валидатор недоступен, проверено по упрощённой схеме»")
Rel(rules, standard_queue, "Обязательный сигнал при отказе валидатора", "если кейс ещё не разобран; проверка дедупликации по operation_id")

note bottom of log
    ⚠️7
end note

@enduml
